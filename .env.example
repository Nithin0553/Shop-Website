# Running `npm run setup` generates a .env file for local use automatically.
# For production, configure these in your hosting provider's secret settings.
PORT=3000
ADMIN_PASSWORD=REPLACE_WITH_A_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_24_CHARACTERS
