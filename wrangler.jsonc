{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sri-sai-shanmukha-auto-centre",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/spare-parts",
      "/brands",
      "/about",
      "/blogs",
      "/blogs/*",
      "/contact",
      "/admin",
      "/admin/",
      "/sitemap.xml",
      "/festival-palettes.css",
      "/api/*",
      "/assets/custom-*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sssa-shop-data",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
